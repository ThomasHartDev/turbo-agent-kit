{
  "name": "@agent/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agent/core": "workspace:*",
    "@agent/llm": "workspace:*",
    "@agent/rate-limiter": "workspace:*",
    "@agent/telemetry": "workspace:*",
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
